# ===== Base de données =====
# SQLite local par defaut. En prod (Render) : URL Neon + USE_POSTGRES=true.
DATABASE_URL=sqlite:///instance/app.db
USE_POSTGRES=false
# Mot de passe du compte admin cree automatiquement si la base est vide
# (sinon un mot de passe aleatoire est genere et affiche une fois dans les logs)
BOOTSTRAP_ADMIN_PASSWORD=
# Reset one-time du mot de passe admin (aucun fallback en dur) — laisser vide
# pour desactiver le reset.
ADMIN_RESET_PASSWORD=

# ===== Sécurité =====
SECRET_KEY=change-me-in-production

# ===== Mail sortant (notifications) =====
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=ton.email@outlook.com
MAIL_PASSWORD=ton_mot_de_passe_outlook
MAIL_DEFAULT_SENDER=ton.email@outlook.com

# ===== Boîte mail entrante (IMAP — suggestions depuis les mails) =====
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_SERVER=imap.gmail.com
MAILBOX_PORT=993
MAILBOX_USE_SSL=true
MAILBOX_FOLDER=INBOX
MAILBOX_ALLOWED_SENDERS=

# ===== Intégrations =====
PENNYLANE_API_KEY=
PENNYLANE_BASE_URL=https://api.pennylane.com
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX_EMAIL=
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TEAM_ID=
OPENROUTER_API_KEY=

# ===== Outils (tests / CI / migration — rarement necessaire en prod) =====
# ORBIT_SQLITE_PATH=     # base SQLite jetable pour les tests
# ORBIT_SKIP_DB_INIT=1   # ignorer create_all au chargement (outilage migrations)
# ORBIT_NO_SCHEDULER=1   # ne pas demarrer les crons (tests/CI)

